
import java.util.*;
class Main{
  public static int NumberOfCarries(int num1, int num2){
     int carries = 0;
     int temp1 = num1;
     int temp2 = num2;
     int rem = 0;
     while(temp1 != 0 && temp2 !=0){
       int d1 = temp1%10;
       int d2 = temp2%10;
      if((d1 + d2 + rem) > 9){
        carries++;
        int sum = d1 + d2 + rem;
        rem = sum/10;
      }
      temp1 = temp1/10;
      temp2 = temp2/10;
     }
      while(temp1 !=0){
        int d1 = temp1%10;
        if((d1 + rem) >9){
          carries++;
          int sum = d1 + rem;
          rem = sum/10;
        }
        temp1 = temp1/10;
     }
     while(temp2 != 0){
      int d2 = temp2%10;
      if((d2 + rem)>9){
        carries++;
        int sum = d2 + rem;
        rem = sum/10;
      }
      temp2 = temp2/10;
     }
     return carries;
  }
  public static void main(String args[]){
  Scanner sc = new Scanner(System.in);
  int num1 = sc.nextInt();
  int num2 = sc.nextInt();
  System.out.println(NumberOfCarries(num1, num2));
}
}
