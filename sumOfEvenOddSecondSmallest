import java.util.*;

public class Main {
    public static int sumOfEvenOddSecondSmallest(int arr[], int n){
       if(n<=3){
        return 0;
       }
       List<Integer> even = new ArrayList<>();
       List<Integer> odd = new ArrayList<>();
       even.add(arr[0]);
       for(int i=1; i<n; i++){
        if(i%2 == 0){
          even.add(arr[i]);
        }else{
          odd.add(arr[i]);
        }
       }
       Collections.sort(even);
       Collections.sort(odd);
       return even.get(even.size() -2) + odd.get(odd.size() - 2);
    }
    public static void main(String[] args) {
      System.out.println("Hello, World!");
      Scanner sc = new Scanner(System.in);
      int n = sc.nextInt();
      int arr[] = new int[n];
      for(int i=0; i<n; i++){
        arr[i] = sc.nextInt();
      }
      System.out.println(sumOfEvenOddSecondSmallest(arr, n));
    }
}
