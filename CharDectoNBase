import java.util.*;

public class Main {
    public static String CharDectoNBase(int n, int num){
       String res = "";
       int quotint = num/n;
       ArrayList<Integer> rem = new ArrayList<>();
       rem.add(num%n);
       while(quotint != 0){
        rem.add(quotint%n);
        quotint = quotint/n;
       }
       for(int i=0; i<rem.size(); i++){
        if(rem.get(i) > 9){
          res = (char)(rem.get(i) - 9 + 64) + res;
        }else{
          res = rem.get(i) + res;
        }
       }
      return res;
    }
    public static void main(String[] args) {
      System.out.println("Hello, World!");
      Scanner sc = new Scanner(System.in);
      int n = sc.nextInt();
      int num = sc.nextInt();
      System.out.println(CharDectoNBase(n, num));
    }
}
